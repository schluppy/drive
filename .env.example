# Kopieren nach .env und mit vim anpassen:  cp .env.example .env && chmod 600 .env && vim .env
# Geheimen Schlüssel erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bitte-aendern
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=drive.example.org
BASIS_URL=https://drive.example.org
HINTER_PROXY=1
# Hostname des Containers (für den Mailversand)
DRIVE_HOST=drive.example.org

POSTGRES_DB=drive
POSTGRES_USER=drive
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_HOST=db

# E-Mail über msmtp (Konto „drive“ in ./msmtprc)
EMAIL_BACKEND=portal.mail_backend.MsmtpBackend
MSMTP_ACCOUNT=drive
DEFAULT_FROM_EMAIL=Drive <drive@example.org>
# Zum Ausprobieren ohne Mailserver (Anmeldelink steht dann im Log):
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Betreiber (erscheint im Datenschutzhinweis)
BETREIBER_NAME=
BETREIBER_EMAIL=

# Sicherung (betrieb/backup.sh): höchstens so viele Tage in /var/backups/drive; optional Kopie in ein weiteres Verzeichnis
BACKUP_TAGE=14
BACKUP_EXTERN=
